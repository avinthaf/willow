# Copy to .env.local and fill in. .env.local is git-ignored.

# Neon pooled connection string (used by the MCP server).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct (unpooled) connection string (used by migrate and backfill).
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Neon branch name. Optional.
NEON_BRANCH=main

# OpenAI key for embeddings (text-embedding-3-small).
# Without it, memories still save, but the embedding stays empty until you run `npm run backfill`.
OPENAI_API_KEY=sk-...
